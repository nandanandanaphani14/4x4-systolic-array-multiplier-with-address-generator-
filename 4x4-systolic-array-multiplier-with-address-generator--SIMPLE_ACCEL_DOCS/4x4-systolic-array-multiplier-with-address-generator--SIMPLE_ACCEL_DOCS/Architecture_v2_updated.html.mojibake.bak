  line-by-line code walkthroughs. Â·
  <a href="description_index.md">description_index.md</a> â€” master file index. Â·
  <a href="design_files_description.md">design_files_description.md</a> â€” per-module reference. Â·
  <a href="testbench_description.md">testbench_description.md</a> â€” per-testbench reference. Â·
  <a href="../indi_ver_rep/verification_report.md">verification_report.md</a> â€” results and coverage
  boundaries. Â·
  <a href="../context_mkdwn/00-index.md">context_mkdwn/</a> â€” derivations and design decisions.</p>
  <p>Regression baseline: 13/13 passing, 3 902 checks, 0 mismatches. QuestaSim 2021.1, run
  2026-07-30.</p>
</div>

</div>

<style>
  .pe{height:66px}
  .rowlab div,.wl .cellv{height:66px}
  .arrwrap{margin-top:4px}
  .skewpipe{display:flex;align-items:center;justify-content:center;gap:3px;height:66px;min-width:70px;
            font:600 10px var(--mono);color:var(--muted)}
  .skewpipe i{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;
              border:1px solid var(--line2);border-radius:4px;font-style:normal;font-size:9.5px;background:var(--bg)}
  .skewpipe i.f{border-color:var(--a);color:var(--a);background:var(--abg)}
  .dsk{display:grid;grid-template-columns:repeat(4,minmax(84px,1fr));gap:6px}
  .dsk .b{border:1px dashed var(--line2);border-radius:6px;padding:3px 2px;text-align:center;
          font:600 10px var(--mono);color:var(--muted);background:var(--bg)}
  .skewgrid{display:grid;grid-template-columns:auto auto auto auto;gap:6px 12px;align-items:center;
            justify-content:center;font:600 13px var(--mono)}
  .skewgrid .h{font:600 10.5px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
  .skewgrid .v{border:1px solid var(--line);border-radius:6px;padding:5px 0;text-align:center;min-width:62px;background:var(--bg);color:var(--muted)}
  .skewgrid .v.on{border-color:var(--a);background:var(--abg);color:var(--a)}
  .skewgrid .p{font:500 10px var(--mono);color:var(--muted);text-align:center}
  @media print{ .skewpipe i{border-color:#999} }
</style>

<script>
(function(){
'use strict';
var $  = function(id){ return document.getElementById(id); };
var s8 = function(v){ return ((v & 0xFF) << 24) >> 24; };
var fmt= function(v){ return (v===null||v===undefined) ? 'â€”' : String(v); };

/* ================================================================
   1.  delay_pipe  --  faithful model of design_rtl/delay_pipe.sv
   ================================================================
   DELAY == 0  ->  dout = din                       (combinational wire)
   DELAY  > 0  ->  pipe[0] <= din;  pipe[i] <= pipe[i-1];  dout = pipe[DELAY-1]

   Frame k shows the situation DURING cycle k: din is the value driven
   now, `st` is the register contents right now (before edge k), and
   dout is what a downstream flop would capture at edge k.
   Under that convention  dout(k) == din(k - DELAY)  holds for every
   depth INCLUDING zero -- which is exactly why tb_delay_pipe samples on
   the negative edge.                                                */

var PIPE_DIN = [7, -3, 12, 0, 25, -8, 4, 19, -11, 6, 30, 2];

function pipeFrames(delay){
  var out = [], st = new Array(delay).fill(0), k, i, ns, din, dout;
  for(k = 1; k <= PIPE_DIN.length; k++){
    din  = PIPE_DIN[k-1];
    dout = (delay === 0) ? din : st[delay-1];
    out.push({ cyc:k, din:din, st:st.slice(), dout:dout });
    if(delay > 0){ ns = st.slice(); for(i = delay-1; i >= 1; i--) ns[i] = st[i-1]; ns[0] = din; st = ns; }
  }
  return out;
}

(function initPipe(){
  var row = $('pipeRow'), sel = $('pipeDelay'), cycEl = $('pipeCyc'), relEl = $('pipeRel');
  if(!row) return;
  var delay = 3, frames = pipeFrames(delay), idx = 0, timer = null;

  function build(){
    row.innerHTML = '';
    function slot(cls, cap){
      var d = document.createElement('div'); d.className = 'slot ' + cls;
      var c = document.createElement('span'); c.className = 'cap'; c.textContent = cap;
      d.appendChild(c);
      var v = document.createElement('span'); v.className = 'val'; d.appendChild(v);
      row.appendChild(d); return v;
    }
    var refs = { st:[] };
    refs.din = slot('din', 'din');
    for(var i = 0; i < delay; i++){
      var a = document.createElement('span'); a.className = 'arrow'; a.textContent = 'â–¶'; row.appendChild(a);
      refs.st.push(slot('stage', 'pipe[' + i + ']'));
    }
    var a2 = document.createElement('span'); a2.className = 'arrow'; a2.textContent = 'â–¶'; row.appendChild(a2);
    refs.dout = slot('dout', 'dout');
    return refs;
  }
  var refs = build();

  function draw(){
    var f = frames[idx];
    cycEl.textContent = f.cyc;
    refs.din.textContent = f.din;
    for(var i = 0; i < delay; i++) refs.st[i].textContent = f.st[i];
    refs.dout.textContent = f.dout;
    relEl.textContent = delay === 0
      ? 'dout(m) = din(m)   â€” a plain wire, no register'
      : 'dout(m) = din(mâˆ’' + delay + ')';
  }
  function step(){ idx = (idx + 1) % frames.length; draw(); }
  function stop(){ if(timer){ clearInterval(timer); timer = null; $('pipePlay').textContent = 'â–¶ Play'; } }

  $('pipePlay').onclick  = function(){ if(timer) stop(); else { timer = setInterval(step, 700); this.textContent = 'âšâš Pause'; } };
  $('pipeStep').onclick  = function(){ stop(); step(); };
  $('pipeReset').onclick = function(){ stop(); idx = 0; draw(); };
  sel.onchange = function(){ stop(); delay = parseInt(this.value,10); frames = pipeFrames(delay); refs = build(); idx = 0; draw(); };
  draw();

  /* ---- static trace: all four depths side by side ---- */
  var all = [0,1,2,3].map(pipeFrames);
  var h = '<table><thead><tr><th>cycle</th><th>din</th>' +
          '<th>dout D=0</th><th>dout D=1</th><th>dout D=2</th><th>dout D=3</th><th>relation check</th></tr></thead><tbody>';
  for(var k = 0; k < PIPE_DIN.length; k++){
    var expect3 = (k-3 >= 0) ? PIPE_DIN[k-3] : 0;
    h += '<tr><td class="mut">' + (k+1) + '</td><td>' + PIPE_DIN[k] + '</td>' +
         '<td>' + all[0][k].dout + '</td><td>' + all[1][k].dout + '</td>' +
         '<td>' + all[2][k].dout + '</td><td class="hi">' + all[3][k].dout + '</td>' +
         '<td class="mut">dout(D=3) = din(' + (k+1-3) + ') = ' + expect3 +
         (all[3][k].dout === expect3 ? ' âœ“' : ' âœ—') + '</td></tr>';
  }
  $('pipeTrace').innerHTML = h + '</tbody></table>';
})();


/* ================================================================
   2.  input_skew_buffer  --  ROWS pairs of delay_pipe, DELAY = r
   ================================================================ */

var AVEC = [[1,2,3,4], [5,-1,0,2], [-2,3,1,1]];   /* lane r = array row r */
var ROWS = 4, COLS = 4;

/* dense vector presented on cycles 1, 2, 3; idle otherwise */
function denseAt(k){
  return (k >= 1 && k <= AVEC.length)
    ? { a:AVEC[k-1], v:1, tag:'A' + (k-1) }
    : { a:[0,0,0,0], v:0, tag:null };
}

function skewFrames(nCyc){
  var out = [], st = [], k, r, i, dn, west, wtag, ns;
  for(r = 0; r < ROWS; r++) st.push(new Array(r).fill(null));
  for(k = 1; k <= nCyc; k++){
    dn = denseAt(k); west = []; wtag = [];
    for(r = 0; r < ROWS; r++){
      if(r === 0){ west.push(dn.v ? dn.a[0] : null); wtag.push(dn.tag); }
      else       { var c = st[r][r-1]; west.push(c ? c.val : null); wtag.push(c ? c.tag : null); }
    }
    out.push({ cyc:k, dense:dn, west:west, wtag:wtag, st:st.map(function(x){ return x.slice(); }) });
    /* clock edge: shift every pipe */
    ns = [];
    for(r = 0; r < ROWS; r++){
      var p = st[r].slice();
      for(i = r-1; i >= 1; i--) p[i] = st[r][i-1];
      if(r > 0) p[0] = dn.v ? { val:dn.a[r], tag:dn.tag } : null;
      ns.push(p);
    }
    st = ns;
  }
  return out;
}

(function initSkew(){
  var body = $('skewBody'); if(!body) return;
  var frames = skewFrames(9), idx = 0, timer = null;

  var html = '<div class="skewgrid">' +
    '<div class="h">array row</div><div class="h">dense_a_in</div><div class="h">delay_pipe</div><div class="h">west edge</div>';
  for(var r = 0; r < ROWS; r++){
    html += '<div class="p">row ' + r + '</div>' +
            '<div class="v" id="sd' + r + '">â€”</div>' +
            '<div class="skewpipe" id="sp' + r + '"></div>' +
            '<div class="v" id="sw' + r + '">â€”</div>';
  }
  body.innerHTML = html + '</div>';

  function draw(){
    var f = frames[idx];
    $('skewCyc').textContent = f.cyc;
    for(var r = 0; r < ROWS; r++){
      var d = $('sd' + r), w = $('sw' + r), p = $('sp' + r);
      d.textContent = f.dense.v ? f.dense.a[r] : 'â€”';
      d.className   = 'v' + (f.dense.v ? ' on' : '');
      w.textContent = f.west[r] === null ? 'â€”' : f.west[r];
      w.className   = 'v' + (f.west[r] === null ? '' : ' on');
      if(r === 0){ p.innerHTML = '<span>DELAY&nbsp;0 &mdash; wire</span>'; }
      else{
        var s = 'DELAY&nbsp;' + r + '&nbsp;';
        for(var i = 0; i < r; i++){
          var cell = f.st[r][i];
          s += '<i class="' + (cell ? 'f' : '') + '">' + (cell ? cell.val : 'Â·') + '</i>';
        }
        p.innerHTML = s;
      }
    }
  }
  function step(){ idx = (idx + 1) % frames.length; draw(); }
  function stop(){ if(timer){ clearInterval(timer); timer = null; $('skewPlay').textContent = 'â–¶ Play'; } }
  $('skewPlay').onclick  = function(){ if(timer) stop(); else { timer = setInterval(step, 850); this.textContent = 'âšâš Pause'; } };
  $('skewStep').onclick  = function(){ stop(); step(); };
  $('skewReset').onclick = function(){ stop(); idx = 0; draw(); };
  draw();

  var t = '<table><thead><tr><th>cycle</th><th>dense_a_in (row 0..3)</th>' +
          '<th>west edge row 0</th><th>row 1</th><th>row 2</th><th>row 3</th><th>vectors in flight</th></tr></thead><tbody>';
  frames.forEach(function(f){
    var live = f.wtag.filter(function(x){ return x; });
    var uniq = live.filter(function(v,i){ return live.indexOf(v) === i; });
    t += '<tr><td class="mut">' + f.cyc + '</td>' +
         '<td>' + (f.dense.v ? f.dense.tag + ' = [' + f.dense.a.join(', ') + ']' : 'â€” (valid = 0)') + '</td>';
    for(var r = 0; r < ROWS; r++){
      t += '<td' + (f.west[r] === null ? ' class="mut"' : ' class="hi"') + '>' +
           (f.west[r] === null ? 'â€”' : f.west[r] + ' Â·' + f.wtag[r]) + '</td>';
    }
    t += '<td class="mut">' + (uniq.length ? uniq.join(' + ') : 'â€”') + '</td></tr>';
  });
  $('skewTrace').innerHTML = t + '</tbody></table>';
})();


/* ================================================================
   3.  The array  --  cycle-accurate model of array_buf_top
   ================================================================
   Per PE, exactly the four registers of MAC.sv:
       weight_q, a_q, valid_q, psum_q
   Combinational, exactly as in the RTL:
       psum_out = wload ? 32'(weight_q) : psum_q     <-- the key line
       a_out    = a_q
       product  = weight_q * a_in ;  adder = psum_in + product
   Update (non-blocking, so every read is of the PRE-edge value):
       weight_q <= wload ? psum_in[7:0] : weight_q
       psum_q   <= valid_in ? adder : psum_in                        */

var WMAT = [[ 2,-1, 3, 0],
            [ 1, 4,-2, 5],
            [-3, 2, 1, 1],
            [ 0, 1, 2,-4]];

/* independent golden model -- exactly what the testbenches compute */
var GOLD = AVEC.map(function(a){
  var row = [], c, r, s;
  for(c = 0; c < COLS; c++){ s = 0; for(r = 0; r < ROWS; r++) s += a[r] * WMAT[r][c]; row.push(s); }
  return row;
});

var N_WLOAD = ROWS, N_FLUSH = ROWS + 2, N_COMP = AVEC.length, N_DRAIN = 8;
var C_WLOAD = N_WLOAD, C_FLUSH = C_WLOAD + N_FLUSH, C_COMP = C_FLUSH + N_COMP,
    C_DRAIN = C_COMP + N_DRAIN, C_TOTAL = C_DRAIN + 1;

function schedule(k){
  if(k >= 1 && k <= C_WLOAD){
    var wr = ROWS - k;                       /* 3, 2, 1, 0  -- BOTTOM ROW FIRST */
    return { ph:'WLOAD', wload:1, wrow:wr, pTop:WMAT[wr].slice(), a:[0,0,0,0], v:0, tag:null };
  }
  if(k <= C_FLUSH)  return { ph:'FLUSH',   wload:0, wrow:null, pTop:[0,0,0,0], a:[0,0,0,0], v:0, tag:null };
  if(k <= C_COMP){
    var i = k - C_FLUSH - 1;
    return { ph:'COMPUTE', wload:0, wrow:null, pTop:[0,0,0,0], a:AVEC[i].slice(), v:1, tag:'A'+i };
  }
  if(k <= C_DRAIN)  return { ph:'DRAIN', wload:0, wrow:null, pTop:[0,0,0,0], a:[0,0,0,0], v:0, tag:null };
  return { ph:'DONE', wload:0, wrow:null, pTop:[0,0,0,0], a:[0,0,0,0], v:0, tag:null };
}

function arrayFrames(){
  var pe = [], ap = [], vp = [], op = [], r, c, i, k, frames = [];
  for(r = 0; r < ROWS; r++){
    pe.push([]); for(c = 0; c < COLS; c++) pe[r].push({ w:0, a:0, v:0, p:0 });
    ap.push(new Array(r).fill(0)); vp.push(new Array(r).fill(0));
  }
  for(c = 0; c < COLS; c++) op.push(new Array(COLS-1-c).fill(0));

  for(k = 1; k <= C_TOTAL; k++){
    var inp = schedule(k);

    /* ---- input skew buffer output = the array's west edge this cycle ---- */
    var aW = [], vW = [];
    for(r = 0; r < ROWS; r++){
      aW.push(r === 0 ? inp.a[0] : ap[r][r-1]);
      vW.push(r === 0 ? inp.v    : vp[r][r-1]);
    }

    /* ---- combinational nets, all from PRE-edge register values ---- */
    var aNet = [], vNet = [], pNet = [];
    for(r = 0; r <= ROWS; r++) pNet.push(new Array(COLS).fill(0));
    for(c = 0; c < COLS; c++) pNet[0][c] = inp.pTop[c];
    for(r = 0; r < ROWS; r++){
      aNet.push(new Array(COLS+1).fill(0)); vNet.push(new Array(COLS+1).fill(0));
      aNet[r][0] = aW[r]; vNet[r][0] = vW[r];
      for(c = 0; c < COLS; c++){ aNet[r][c+1] = pe[r][c].a; vNet[r][c+1] = pe[r][c].v; }
    }
    for(c = 0; c < COLS; c++)
      for(r = 0; r < ROWS; r++)
        pNet[r+1][c] = inp.wload ? pe[r][c].w : pe[r][c].p;

    var bottomPre = []; for(c = 0; c < COLS; c++) bottomPre.push(pNet[ROWS][c]);

    /* ---- apply clock edge k ---- */
    var nx = [], acc = [];
    for(r = 0; r < ROWS; r++){
      nx.push([]); acc.push([]);
      for(c = 0; c < COLS; c++){
        var o = pe[r][c], ain = aNet[r][c], vin = vNet[r][c], pin = pNet[r][c];
        nx[r].push({
          w: inp.wload ? s8(pin) : o.w,
          a: ain,
          v: vin,
          p: vin ? (pin + o.w * ain) : pin
        });
        acc[r].push(!!vin);
      }
    }
    for(r = ROWS-1; r >= 1; r--){
      var na = ap[r].slice(), nv = vp[r].slice();
      for(i = r-1; i >= 1; i--){ na[i] = ap[r][i-1]; nv[i] = vp[r][i-1]; }
      na[0] = inp.a[r]; nv[0] = inp.v; ap[r] = na; vp[r] = nv;
    }
    for(c = 0; c < COLS; c++){
      var d = COLS-1-c; if(d === 0) continue;
      var no = op[c].slice();
      for(i = d-1; i >= 1; i--) no[i] = op[c][i-1];
      no[0] = bottomPre[c]; op[c] = no;
    }
    pe = nx;

    /* ---- buses observable immediately AFTER edge k ---- */
    var bottom = [], result = [];
    for(c = 0; c < COLS; c++){
      bottom.push(inp.wload ? pe[ROWS-1][c].w : pe[ROWS-1][c].p);
      result.push((COLS-1-c) === 0 ? bottom[c] : op[c][COLS-2-c]);
    }

    frames.push({
      cyc:k, ph:inp.ph, wrow:inp.wrow, wload:inp.wload, pTop:inp.pTop.slice(),
      aW:aW, vW:vW, acc:acc, bottom:bottom, result:result,
      pe: pe.map(function(row){ return row.map(function(x){ return { w:x.w, a:x.a, v:x.v, p:x.p }; }); }),
      dsk: op.map(function(x){ return x.slice(); }),
      tag: inp.tag
    });
  }
  return frames;
}

(function initArray(){
  var body = $('arrBody'); if(!body) return;
  var F = arrayFrames(), idx = 0, timer = null;

  /* result vector i lands just after cycle  C_FLUSH + 1 + i + 6 */
  var landing = {};
  for(var i = 0; i < AVEC.length; i++) landing[C_FLUSH + 1 + i + (ROWS + COLS - 2)] = i;

  /* --- build the phase timeline --- */
  var tl = $('arrTl');
  tl.innerHTML =
    '<div class="t-w" style="flex:' + N_WLOAD + '">WLOAD</div>' +
    '<div class="t-f" style="flex:' + N_FLUSH + '">FLUSH</div>' +
    '<div class="t-c" style="flex:' + N_COMP  + '">COMP</div>' +
    '<div class="t-d" style="flex:' + N_DRAIN + '">DRAIN</div>' +
    '<div class="t-o" style="flex:1">D</div>';

  /* --- build the stage DOM once --- */
  var h = '<div class="sect-lab">north edge â€” psum_in_top (weight row while wload = 1, zeros otherwise)</div>' +
          '<div class="colhdr"><div>col 0</div><div>col 1</div><div>col 2</div><div>col 3</div></div>' +
          '<div class="edge" id="aTop"></div>' +
          '<div class="arrwrap"><div class="rowlab" id="aLab"></div><div class="wl" id="aWest"></div>' +
          '<div class="cellgrid" id="aGrid"></div></div>' +
          '<div class="sect-lab">south edge â€” psum_out_bottom, before de-skew (the staircase)</div>' +
          '<div class="edge" id="aBot"></div>' +
          '<div class="sect-lab">output_deskew_buffer â€” delay COLSâˆ’1âˆ’c</div>' +
          '<div class="dsk" id="aDsk"></div>' +
          '<div class="sect-lab">result â€” aligned, all four lanes on the same cycle</div>' +
          '<div class="edge" id="aRes"></div>';
  body.innerHTML = h;

  var gTop = $('aTop'), gBot = $('aBot'), gRes = $('aRes'), gLab = $('aLab'),
      gW = $('aWest'), gG = $('aGrid'), gD = $('aDsk');
  var cTop = [], cBot = [], cRes = [], cW = [], cPE = [], cD = [];
  var r, c, d;
  for(c = 0; c < COLS; c++){
    cTop.push(gTop.appendChild(document.createElement('div'))); cTop[c].className = 'eb';
    cBot.push(gBot.appendChild(document.createElement('div'))); cBot[c].className = 'eb p';
    cRes.push(gRes.appendChild(document.createElement('div'))); cRes[c].className = 'eb p';
    cD.push(gD.appendChild(document.createElement('div')));     cD[c].className   = 'b';
  }
  for(r = 0; r < ROWS; r++){
    var lb = document.createElement('div'); lb.textContent = 'row ' + r; gLab.appendChild(lb);
    var wv = document.createElement('div'); wv.className = 'cellv'; gW.appendChild(wv); cW.push(wv);
  }
  for(r = 0; r < ROWS; r++){
    cPE.push([]);
    for(c = 0; c < COLS; c++){
      var p = document.createElement('div'); p.className = 'pe';
      p.innerHTML = '<span class="wq"></span><span class="aq"></span><span class="pq"></span>' +
                    '<span class="tag">' + r + ',' + c + '</span>';
      gG.appendChild(p);
      cPE[r].push({ box:p, w:p.querySelector('.wq'), a:p.querySelector('.aq'), p:p.querySelector('.pq') });
    }
  }

  function draw(){
    var f = F[idx], r, c;
    $('arrCyc').textContent = f.cyc;
    var ph = $('arrPhase'); ph.textContent = f.ph; ph.setAttribute('data-p', f.ph);
    var segs = tl.children, on = { WLOAD:0, FLUSH:1, COMPUTE:2, DRAIN:3, DONE:4 }[f.ph];
    for(var s = 0; s < segs.length; s++) segs[s].className = segs[s].className.replace(' on','') + (s === on ? ' on' : '');

    for(c = 0; c < COLS; c++){
      cTop[c].textContent = f.wload ? f.pTop[c] : '0';
      cTop[c].className   = 'eb' + (f.wload ? ' w' : ' dim');
      cBot[c].textContent = f.bottom[c];
      cBot[c].className   = 'eb p' + (f.bottom[c] !== 0 && f.ph !== 'WLOAD' ? ' hot' : (f.bottom[c] === 0 ? ' dim' : ' w'));
      cRes[c].textContent = f.result[c];
      cRes[c].className   = 'eb p' + (landing[f.cyc] !== undefined ? ' hot' : (f.result[c] === 0 ? ' dim' : ''));
      var dep = COLS-1-c;
      cD[c].innerHTML = dep === 0 ? 'DELAY 0 â€” wire'
                                  : 'DELAY ' + dep + ' [' + f.dsk[c].join(', ') + ']';
    }
    for(r = 0; r < ROWS; r++){
      cW[r].textContent = f.vW[r] ? f.aW[r] : 'â€”';
      cW[r].className   = 'cellv' + (f.vW[r] ? ' live' : ' off');
      for(c = 0; c < COLS; c++){
        var q = cPE[r][c], st = f.pe[r][c];
        q.w.textContent = 'w=' + st.w;
        q.a.textContent = 'a=' + st.a;
        q.p.textContent = st.p;
        q.p.className   = 'pq' + (st.p === 0 ? ' zero' : '');
        q.box.className = 'pe' + (f.wload ? ' shift' : (f.acc[r][c] ? ' acc' : ''));
      }
    }
    if(landing[f.cyc] !== undefined){
      var i = landing[f.cyc], ok = f.result.every(function(v, j){ return v === GOLD[i][j]; });
      $('arrCheck').textContent = 'C' + i + ' = [' + f.result.join(', ') + ']  ' + (ok ? 'âœ“ matches golden' : 'âœ— MISMATCH');
      $('arrCheck').className   = 'pill ' + (ok ? 'ok' : 'bad');
    } else if(f.cyc === 1){
      $('arrCheck').textContent = 'golden check: pending'; $('arrCheck').className = 'pill';
    }
  }
  function step(){ idx = (idx + 1) % F.length; draw(); }
  function stop(){ if(timer){ clearInterval(timer); timer = null; $('arrPlay').textContent = 'â–¶ Play'; } }
  function play(){ stop(); timer = setInterval(step, parseInt($('arrSpeed').value,10)); $('arrPlay').textContent = 'âšâš Pause'; }

  $('arrPlay').onclick  = function(){ if(timer) stop(); else play(); };
  $('arrStep').onclick  = function(){ stop(); step(); };
  $('arrBack').onclick  = function(){ stop(); idx = (idx - 1 + F.length) % F.length; draw(); };
  $('arrReset').onclick = function(){ stop(); idx = 0; draw(); };
  $('arrSpeed').oninput = function(){ if(timer) play(); };
  draw();

  /* ---- full static trace ---- */
  var t = '<table><thead><tr><th>cycle</th><th>phase</th><th>north edge (psum_in_top)</th>' +
          '<th>west edge (after skew)</th><th>bottom (psum_out_bottom)</th>' +
          '<th>result (after de-skew)</th><th>note</th></tr></thead><tbody>';
  F.forEach(function(f){
    var land = landing[f.cyc], note = '', cls = '';
    if(f.ph === 'WLOAD'){ note = 'weight row W[' + f.wrow + '] â†’ shifts down; lands in array row ' + f.wrow; cls = ' class="wl2"'; }
    else if(f.ph === 'FLUSH')   note = 'zeros pushed through, valid = 0 â€” clearing weight residue';
    else if(f.ph === 'COMPUTE') note = 'vector ' + f.tag + ' consumed at this edge';
    else if(land !== undefined) note = 'C' + land + ' complete â€” golden [' + GOLD[land].join(', ') + ']';
    else if(f.ph === 'DRAIN')   note = 'pipeline draining';
    var westTxt = f.aW.map(function(v, r){ return f.vW[r] ? v : 'â€”'; }).join(', ');
    t += '<tr' + cls + '><td class="mut">' + f.cyc + '</td><td>' + f.ph + '</td>' +
         '<td>[' + (f.wload ? f.pTop.join(', ') : '0, 0, 0, 0') + ']</td>' +
         '<td>[' + westTxt + ']</td>' +
         '<td>[' + f.bottom.join(', ') + ']</td>' +
         '<td' + (land !== undefined ? ' class="hi"' : '') + '>[' + f.result.join(', ') + ']</td>' +
         '<td class="mut">' + note + '</td></tr>';
  });
  $('arrTrace').innerHTML = t + '</tbody></table>';
})();
})();
</script>
</body>
</html>


